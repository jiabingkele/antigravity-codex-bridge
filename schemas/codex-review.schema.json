{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodexReviewReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "issues",
    "summary"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["approve", "changes_requested"],
      "description": "无阻塞或高危问题填 approve，否则填 changes_requested。"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "file", "line", "problem", "fix"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "description": "从 1 开始的行号；文件级问题填 0。"
          },
          "problem": {
            "type": "string",
            "description": "使用简洁客观的简体中文描述具体缺陷，不使用防御性套话。"
          },
          "fix": {
            "type": "string",
            "description": "使用简体中文给出直接可执行的修复方法。"
          }
        }
      },
      "description": "仅列有实质价值的缺陷，忽略无关痛痒的代码风格挑刺。"
    },
    "summary": {
      "type": "string",
      "description": "用一句简明客观的简体中文总结本次审查结论。"
    }
  }
}
