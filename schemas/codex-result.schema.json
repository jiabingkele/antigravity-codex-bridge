{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodexExecutionReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "changed_files",
    "summary",
    "checks",
    "blockers"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["done", "blocked", "needs_input"],
      "description": "任务和检查全部通过填 done；遇到无法自行解决的故障填 blocked；需要用户拍板业务取舍填 needs_input。"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "本次新建、修改或删除的文件相对路径列表。"
    },
    "summary": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "最多 5 条简明客观的简体中文改动要点。禁止免责声明、防御性措辞或粘贴大段代码。"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "passed", "note"],
        "properties": {
          "command": {
            "type": "string",
            "description": "实际执行的验证命令（测试/lint/类型检查/构建）。"
          },
          "passed": {
            "type": "boolean",
            "description": "该命令退出码是否为 0。"
          },
          "note": {
            "type": "string",
            "description": "用一行简明简体中文说明结果（如“1 项测试全部通过”或具体失败原因）。"
          }
        }
      },
      "description": "结束前实际执行过的验收命令列表。"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "使用简体中文列出真实未解决的堵塞点或待用户决策项；无堵塞则为空数组。"
    }
  }
}
